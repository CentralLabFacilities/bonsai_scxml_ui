{
  "name": "bonsai-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "tauri:dev": "tauri dev",
    "build": "vite build",
    "tauri:build": "bun run build && tauri build",
    "build:binary": "mkdir -p target/dist && bun run build --outDir target/dist && bun run src/embed-assets.js target/dist target/embedded-assets.js && bun build src/server.js --compile --target=bun-linux-x64 --outfile target/bonsai-ui && rm -rf target/dist",
    "lint": "eslint . --max-warnings=0",
    "fmt": "bun fmt src tests",
    "test": "bun test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib --no-default-features --locked",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "verify": "bun run lint && bun run test && bun run test:rust && bun run build && bun run test:browser",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tauri-apps/api": "^2.11.1",
    "@tisoap/react-flow-smart-edge": "^5.0.0",
    "@xyflow/react": "^12.11.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^20.14.5",
    "vite": "^8.1.1"
  }
}
